pkgname=halo
pkgver=0.1.0
pkgrel=1
pkgdesc='Settings for the Glorious GHS Wireless InfinitePlay headset (unofficial)'
arch=('x86_64' 'aarch64')
url='https://github.com/EskimoDirka/halo'
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/halo "$pkgdir/usr/bin/halo"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/halo.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/halo.svg"
  install -Dm644 "$startdir/halo.desktop" "$pkgdir/usr/share/applications/halo.desktop"
  install -Dm644 "$startdir/70-halo.rules" "$pkgdir/usr/lib/udev/rules.d/70-halo.rules"
  install -Dm644 "$startdir/halo-watch.service" "$pkgdir/usr/lib/systemd/user/halo-watch.service"
  # The Omarchy bar widget, for users to copy into their shell config.
  install -d "$pkgdir/usr/share/halo/omarchy"
  cp -r omarchy/halo.battery "$pkgdir/usr/share/halo/omarchy/"
}
